FROM python:3.12-slim
ARG TARGETARCH
WORKDIR /code
COPY requirements.txt ./
RUN sed '/^sentence-transformers/d' requirements.txt > /tmp/runtime-requirements.txt \
    && pip install --no-cache-dir -r /tmp/runtime-requirements.txt 'onnxruntime>=1.20,<2' 'tokenizers>=0.20,<1' 'numpy>=1.26,<3' 'huggingface-hub>=0.26,<3'
COPY scripts/fetch_onnx_models.py scripts/check_model_memory.py ./scripts/
RUN HF_HOME=/tmp/hf python -m scripts.fetch_onnx_models /models --architecture "$TARGETARCH" \
    && rm -rf /tmp/hf
COPY app ./app
ENV ONNX_MODEL_DIR=/models TOKENIZERS_PARALLELISM=false
EXPOSE 8000
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
